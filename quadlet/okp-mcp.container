# OKP MCP server (connects to Solr over the shared network).

[Unit]
Description=OKP MCP server
After=okp-solr.service
Requires=okp-solr.service

[Container]
Image=quay.io/redhat-user-workloads/rhel-lightspeed-tenant/rhel-knowledge-bridge:latest@sha256:42a5b6345041aa364862e0eb1ffe8c716eea91b643b1d3393c15f4da0f8b2134
ContainerName=okp-mcp
Network=okp.network
PublishPort=8000:8000

Environment=MCP_TRANSPORT=streamable-http
Environment=MCP_SOLR_URL=http://okp-solr:8983
AutoUpdate=registry

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
